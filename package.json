{
  "name": "openclaw-lifespan",
  "version": "0.1.3",
  "type": "module",
  "description": "OpenClaw plugin that gives your AI agent a finite lifespan measured in output tokens",
  "author": "minarin0179",
  "license": "MIT",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "lifespan",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minarin0179/lifespan.git"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "node --import tsx/esm --test lib.test.ts"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  }
}
